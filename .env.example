# Gerçek değerleri .env dosyasına yaz (bu dosyayı kopyala: cp .env.example .env)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# @ işareti olmadan TikTok kullanıcı adı (yayını izlenecek hesap)
TIKTOK_KULLANICI=
WS_PORT=8765

# --- YouTube (npm run youtube) ---
# Google Cloud Console > YouTube Data API v3 > Kimlik bilgileri > API anahtarı
YOUTUBE_API_KEY=
# Canlı yayın adresi ya da 11 karakterlik video kimliği (ör. https://youtube.com/live/XXXXXXXXXXX)
YOUTUBE_YAYIN=
# Sohbet okuma aralığı (saniye, en az 5). Uzun yayında kota yetmezse büyüt (ör. 10).
YOUTUBE_ARALIK_SN=5
